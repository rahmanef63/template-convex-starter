# Convex deployment URL ("cloud") — your *.convex.cloud address, used by the
# browser client. SET IN VERCEL. Locally, `npx convex dev` writes it here.
NEXT_PUBLIC_CONVEX_URL=

# Production deploy key ("deploy key") from Convex (Settings -> Deploy Keys).
# SET IN VERCEL. The build (build:auto) uses it to push functions+schema to
# Convex and to auto-provision the auth keys below.
CONVEX_DEPLOY_KEY=

# Convex HTTP/site URL ("site") — your *.convex.site address, serves JWKS/auth.
# AUTO on Convex Cloud (derived from your deployment); only set it manually if
# you run a self-hosted backend.
CONVEX_SITE_URL=

# App public URL ("domain") — where auth redirects land. AUTO-derived from
# VERCEL_URL by scripts/setup-auth.mjs during build. For local dev use below.
SITE_URL=http://localhost:3000

# @convex-dev/auth signing keys. AUTO-SET during build by scripts/setup-auth.mjs
# when CONVEX_DEPLOY_KEY is present (you usually don't touch these). Listed here
# for local dev / manual fallback.
JWKS=
JWT_PRIVATE_KEY=

# OPTIONAL — Claude API key for the built-in AI assistant (/assistant). The app
# runs fine without it; the assistant just stays offline until this is set.
# Get one at https://console.anthropic.com. Server-only — never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# OPTIONAL — showcase-only. Set NEXT_PUBLIC_DEMO=1 on the live template demo so
# the "Clone this project" button renders there; leave it unset in a real clone
# (the cloner already has the repo). NEXT_PUBLIC_CLONE_URL overrides the Vercel
# deploy link that button points at. Both are public by design — lib/stage.ts.
NEXT_PUBLIC_DEMO=
NEXT_PUBLIC_CLONE_URL=

# OPTIONAL — password reset email (Resend). Same posture as the key above: the
# app runs fine without these, "Forgot your password?" just answers "Password
# reset is not configured." until both are set.
#
# They get NO SLOT IN THIS FILE on purpose: nothing in the Next.js process reads
# them, so a key pasted here would sit unread (and one NEXT_PUBLIC_ prefix away
# from the browser bundle). They belong on the CONVEX deployment — the sender
# runs inside a Convex action (convex/_shared/email.ts), which never sees
# Vercel's env. README.md ("Password reset") holds the two commands.

# OPTIONAL — the in-app "Version & updates" card (/os → Settings). Also set on
# the CONVEX deployment, not here, for the same reason as the block above:
#   bunx convex env set VERCEL_DEPLOY_HOOK_URL "https://api.vercel.com/v1/integrations/deploy/..."
#   bunx convex env set OWNER_EMAIL "you@example.com"
# The hook lets the card rebuild your site (Vercel → Project → Settings → Git →
# Deploy Hooks). OWNER_EMAIL restricts who may press it — SET IT once your site
# is public: signup is open, so without it any signed-up stranger can spend your
# build minutes (a global cap of 3/hour applies either way).
